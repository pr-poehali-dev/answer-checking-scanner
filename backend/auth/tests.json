{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Wrong password returns 401",
      "method": "POST",
      "path": "/",
      "body": { "login": "admin", "password": "wrongpass" },
      "expectedStatus": 401
    },
    {
      "name": "Empty credentials returns 400",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Activate trial without login returns 400",
      "method": "POST",
      "path": "/?action=activate-trial",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Confirm-email without login/code returns 400",
      "method": "POST",
      "path": "/?action=confirm-email",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Resend-email-code without login returns 400",
      "method": "POST",
      "path": "/?action=resend-email-code",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Forgot-password without login returns 400",
      "method": "POST",
      "path": "/?action=forgot-password",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Forgot-password unknown login returns 200 (no account leak)",
      "method": "POST",
      "path": "/?action=forgot-password",
      "body": { "login": "unknown_login_xyz_999" },
      "expectedStatus": 200
    },
    {
      "name": "Reset-password-confirm without login/code returns 400",
      "method": "POST",
      "path": "/?action=reset-password-confirm",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Reset-password-confirm short password returns 400",
      "method": "POST",
      "path": "/?action=reset-password-confirm",
      "body": { "login": "unknown_login_xyz_999", "code": "000000", "new_password": "123" },
      "expectedStatus": 400
    },
    {
      "name": "Confirm-email unknown login returns 400 (no active code)",
      "method": "POST",
      "path": "/?action=confirm-email",
      "body": { "login": "unknown_login_xyz", "code": "000000" },
      "expectedStatus": 400
    },
    {
      "name": "Check AI limit without login returns 400",
      "method": "POST",
      "path": "/?action=check-ai-limit",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "GET maintenance returns 200",
      "method": "GET",
      "path": "/?action=maintenance",
      "expectedStatus": 200
    },
    {
      "name": "POST maintenance without admin token returns 403",
      "method": "POST",
      "path": "/?action=maintenance",
      "body": { "sections": ["upload"] },
      "expectedStatus": 403
    },
    {
      "name": "Set-role without admin token returns 403",
      "method": "POST",
      "path": "/?action=set-role",
      "body": { "login": "test", "role": "tester" },
      "expectedStatus": 403
    },
    {
      "name": "GET users without admin token returns 403",
      "method": "GET",
      "path": "/?action=users",
      "expectedStatus": 403
    },
    {
      "name": "GET ip-stats without admin token returns 403",
      "method": "GET",
      "path": "/?action=ip-stats",
      "expectedStatus": 403
    },
    {
      "name": "collective-by-token without params returns 400",
      "method": "GET",
      "path": "/?action=collective-by-token",
      "expectedStatus": 400
    },
    {
      "name": "spend-tokens without login returns 400",
      "method": "POST",
      "path": "/?action=spend-tokens",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "precheck-ai without login returns 400",
      "method": "POST",
      "path": "/?action=precheck-ai",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "get-tokens-balance without login returns 400",
      "method": "GET",
      "path": "/?action=get-tokens-balance",
      "expectedStatus": 400
    },
    {
      "name": "GET lk-visibility returns 200",
      "method": "GET",
      "path": "/?action=lk-visibility",
      "expectedStatus": 200
    },
    {
      "name": "POST lk-visibility without admin token returns 403",
      "method": "POST",
      "path": "/?action=lk-visibility",
      "body": { "role": "student", "hidden": ["upload"] },
      "expectedStatus": 403
    }
  ]
}