{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing image returns 400",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Invalid base64 returns 400",
      "method": "POST",
      "path": "/",
      "body": { "image": "not-a-base64-!!!" },
      "expectedStatus": 400
    },
    {
      "name": "Wrong method returns 405",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Reanalyze mode works without image and without billing",
      "method": "POST",
      "path": "/",
      "body": {
        "answers": ["А", "Б", "В"],
        "answerKey": "АБВ",
        "studentCode": "12345"
      },
      "expectedStatus": 200,
      "expectedBody": { "studentCode": "string" },
      "bodyMatcher": "partial"
    }
  ]
}