{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Пустые бланки на 20 вопросов, 4 варианта",
      "method": "POST",
      "path": "/",
      "body": { "workId": "123456", "workTitle": "Контрольная по математике", "questionsCount": 20, "optionsCount": 4 },
      "expectedStatus": 200,
      "expectedBody": { "questionsCount": 20, "optionsCount": 4 },
      "bodyMatcher": "partial"
    },
    {
      "name": "Бланки на 10 вопросов, 5 вариантов",
      "method": "POST",
      "path": "/",
      "body": { "workId": "654321", "workTitle": "Проверочная", "questionsCount": 10, "optionsCount": 5 },
      "expectedStatus": 200,
      "expectedBody": { "questionsCount": 10, "optionsCount": 5 },
      "bodyMatcher": "partial"
    },
    {
      "name": "Именные бланки с впечатанным кодом ученика",
      "method": "POST",
      "path": "/",
      "body": { "workId": "777777", "workTitle": "Тест", "questionsCount": 10, "optionsCount": 4, "students": [{ "code": "12345", "name": "Иванов Иван", "classLabel": "9А" }, { "code": "54321", "name": "Петров Пётр", "classLabel": "9А" }] },
      "expectedStatus": 200,
      "expectedBody": { "studentsCount": 2 },
      "bodyMatcher": "partial"
    },
    {
      "name": "Wrong method returns 405",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    }
  ]
}
